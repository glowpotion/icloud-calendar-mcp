# Your full iCloud email address.
ICLOUD_USERNAME=you@icloud.com

# An APP-SPECIFIC password from https://appleid.apple.com (Sign-In and Security
# > App-Specific Passwords). Your normal Apple ID password will NOT work while
# two-factor authentication is enabled — which it is, for every modern account.
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Optional. IANA name used for input times that carry no UTC offset, and for
# rendering times back to the caller. Defaults to UTC.
CALDAV_DEFAULT_TIMEZONE=Europe/London

# Optional. Override only if you are pointing at a non-iCloud CalDAV server.
CALDAV_URL=https://caldav.icloud.com

# --- Only for `--transport http` (e.g. running on a Raspberry Pi) ------------
# deploy/install.sh writes these for you into /etc/icloud-calendar-mcp.env.
# MCP_HOST=0.0.0.0            # bind address; default 127.0.0.1
# MCP_PORT=8765
# MCP_AUTH_TOKEN=             # required unless bound to loopback; openssl rand -hex 32
# MCP_ALLOWED_HOSTS=          # optional Host-header allowlist, e.g. pi.local:8765,100.101.102.103:8765
